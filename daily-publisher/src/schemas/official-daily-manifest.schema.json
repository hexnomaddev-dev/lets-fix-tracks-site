{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Let's Fix Tracks official daily distribution manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "date",
    "puzzles"
  ],
  "properties": {
    "format": {
      "const": "lets-fix-tracks.official-daily-package"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "date": {
      "$ref": "#/$defs/date"
    },
    "puzzles": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/puzzle"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "puzzle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "puzzleId",
        "date",
        "difficulty",
        "path",
        "playerFormat",
        "playerSchemaVersion",
        "generatorVersion",
        "canonicalHash",
        "sha256"
      ],
      "properties": {
        "puzzleId": {
          "type": "string",
          "pattern": "^lft_daily_\\d{4}-\\d{2}-\\d{2}_(easy|medium|hard|expert)$"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard",
            "expert"
          ]
        },
        "path": {
          "enum": [
            "easy.json",
            "medium.json",
            "hard.json",
            "expert.json"
          ]
        },
        "playerFormat": {
          "const": "lets-fix-tracks.player-puzzle"
        },
        "playerSchemaVersion": {
          "const": "1.0.0"
        },
        "generatorVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "canonicalHash": {
          "type": "string",
          "pattern": "^lft_hash_[0-9a-f]{16}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
